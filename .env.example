# Copy this file to .env on the server and set your YouTube Live stream key.
# Never commit or share the real .env file.
YOUTUBE_STREAM_KEY=
# Optional: YouTube's standard ingest URL is used if this is omitted.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# Set to true on an always-on server to resume broadcasting after app restarts.
AUTO_START_STREAM=false
# Optional for local use. Required on Azure App Service (16+ characters).
DASHBOARD_USERNAME=asif
DASHBOARD_PASSWORD=
